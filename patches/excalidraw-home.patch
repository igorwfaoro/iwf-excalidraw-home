@@ -0,0 +1,112 @@
+import { useMemo, useState } from "react";
+import { Dialog } from "@excalidraw/excalidraw/components/Dialog";
+import {
+  getServerFileThumbnailUrl,
+  type ServerFileSummary,
+} from "../data/serverFiles";
+
+import "./ServerFilesDialog.scss";
+
+export const ServerFilesDialog = (props: {
+  files: ServerFileSummary[];
+  activeFileId: string | null;
+  onClose: () => void;
+  onOpen: (id: string) => void;
+  onRename: (id: string, name: string) => void;
+  onDelete: (id: string) => void;
+}) => {
+  const [query, setQuery] = useState("");
+  const filteredFiles = useMemo(() => {
+    const normalizedQuery = query.trim().toLocaleLowerCase();
+    return props.files.filter((file) =>
+      file.name.toLocaleLowerCase().includes(normalizedQuery),
+    );
+  }, [props.files, query]);
+
+  return (
+    <Dialog
+      size="wide"
+      title="All server drawings"
+      onCloseRequest={props.onClose}
+    >
+      <div className="server-files-dialog">
+        <input
+          className="server-files-dialog__search"
+          type="search"
+          value={query}
+          onChange={(event) => setQuery(event.target.value)}
+          placeholder="Search drawings"
+          aria-label="Search drawings"
+        />
+        {filteredFiles.length ? (
+          <div className="server-files-dialog__grid">
+            {filteredFiles.map((file) => (
+              <article className="server-files-dialog__card" key={file.id}>
+                <button
+                  className="server-files-dialog__preview"
+                  type="button"
+                  onClick={() => props.onOpen(file.id)}
+                  aria-label={`Open ${file.name}`}
+                >
+                  {file.hasThumbnail ? (
+                    <img
+                      src={getServerFileThumbnailUrl(file.id)}
+                      alt=""
+                      loading="lazy"
+                    />
+                  ) : (
+                    <span>No preview</span>
+                  )}
+                </button>
+                <div className="server-files-dialog__details">
+                  <strong title={file.name}>{file.name}</strong>
+                  <span>
+                    {file.id === props.activeFileId ? "Open · " : ""}
+                    {new Date(file.updatedAt).toLocaleString()}
+                  </span>
+                </div>
+                <div className="server-files-dialog__actions">
+                  <button type="button" onClick={() => props.onOpen(file.id)}>
+                    Open
+                  </button>
+                  <button
+                    type="button"
+                    onClick={() => {
+                      const name = window.prompt("Rename drawing", file.name);
+                      if (name?.trim() && name.trim() !== file.name) {
+                        props.onRename(file.id, name.trim());
+                      }
+                    }}
+                  >
+                    Rename
+                  </button>
+                  <button
+                    className="server-files-dialog__delete"
+                    type="button"
+                    onClick={() => {
+                      if (
+                        window.confirm(
+                          `Delete “${file.name}”? This cannot be undone.`,
+                        )
+                      ) {
+                        props.onDelete(file.id);
+                      }
+                    }}
+                  >
+                    Delete
+                  </button>
+                </div>
+              </article>
+            ))}
+          </div>
+        ) : (
+          <p className="server-files-dialog__empty">
+            {props.files.length
+              ? "No drawings match your search."
+              : "No server drawings yet."}
+          </p>
+        )}
+      </div>
+    </Dialog>
+  );
+};
