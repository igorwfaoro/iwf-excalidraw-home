+export type ServerFileSummary = {
+  id: string;
+  name: string;
+  revision: number;
+  updatedAt: string;
+  hasThumbnail?: boolean;
+};
+
+export type ServerFileDocument = ServerFileSummary & {
+  scene: Record<string, unknown>;
+};
+
+const SERVER_FILES_API = `${import.meta.env.BASE_URL}api/files`;
+
+const request = async <T>(url: string, init?: RequestInit): Promise<T> => {
+  const response = await fetch(url, {
+    ...init,
+    headers: {
+      "Content-Type": "application/json",
+      ...init?.headers,
+    },
+  });
+  const data = await response.json();
+  if (!response.ok) {
+    throw new Error(data.error || `Server returned ${response.status}`);
+  }
+  return data as T;
+};
+
+export const listServerFiles = () =>
+  request<ServerFileSummary[]>(SERVER_FILES_API);
+
+export const getServerFile = (id: string) =>
+  request<ServerFileDocument>(`${SERVER_FILES_API}/${encodeURIComponent(id)}`);
+
+export const getServerFileThumbnailUrl = (id: string) =>
+  `${SERVER_FILES_API}/${encodeURIComponent(id)}/thumbnail`;
+
+export const saveServerFileThumbnail = (
+  id: string,
+  revision: number,
+  thumbnail: string,
+) =>
+  request<ServerFileSummary>(getServerFileThumbnailUrl(id), {
+    method: "PUT",
+    body: JSON.stringify({ revision, thumbnail }),
+  });
+
+export const createServerFile = (
+  name: string,
+  serializedScene: string,
+  thumbnail?: string,
+) =>
+  request<ServerFileSummary>(SERVER_FILES_API, {
+    method: "POST",
+    body: JSON.stringify({
+      name,
+      scene: JSON.parse(serializedScene),
+      thumbnail,
+    }),
+  });
+
+export const saveServerFile = (
+  id: string,
+  name: string,
+  revision: number,
+  serializedScene: string,
+  thumbnail?: string,
+) =>
+  request<ServerFileSummary>(`${SERVER_FILES_API}/${encodeURIComponent(id)}`, {
+    method: "PUT",
+    body: JSON.stringify({
+      name,
+      revision,
+      scene: JSON.parse(serializedScene),
+      thumbnail,
+    }),
+  });
+
+export const renameServerFile = (id: string, name: string) =>
+  request<ServerFileSummary>(`${SERVER_FILES_API}/${encodeURIComponent(id)}`, {
+    method: "PATCH",
+    body: JSON.stringify({ name }),
+  });
+
+export const deleteServerFile = (id: string) =>
+  request<{ id: string }>(`${SERVER_FILES_API}/${encodeURIComponent(id)}`, {
+    method: "DELETE",
+  });
